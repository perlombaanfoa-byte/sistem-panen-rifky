        "class Komoditas:\n",
        "    def __init__(self, nama, harga_per_kg):\n",
        "        self.nama = nama\n",
        "        self.harga_per_kg = harga_per_kg\n",
        "\n",
        "\n",
        "class CatatanPanen:\n",
        "    def __init__(self, id_panen, komoditas, jumlah_kg, tanggal):\n",
        "        self.id_panen = id_panen\n",
        "        self.komoditas = komoditas\n",
        "        self.jumlah_kg = jumlah_kg\n",
        "        self.tanggal = tanggal\n",
        "\n",
        "    def hitung_total_nilai(self):\n",
        "        return self.jumlah_kg * self.komoditas.harga_per_kg\n",
        "\n",
        "\n",
        "class SistemAgroindustri:\n",
        "    def __init__(self, nama_kebun):\n",
        "        self.nama_kebun = nama_kebun\n",
        "        self.daftar_panen = []\n",
        "        self._counter_id = 1\n",
        "\n",
        "    def catat_panen(self, komoditas, jumlah_kg, tanggal):\n",
        "        panen_baru = CatatanPanen(self._counter_id, komoditas, jumlah_kg, tanggal)\n",
        "        self.daftar_panen.append(panen_baru)\n",
        "        self._counter_id += 1\n",
        "        print(f\"[SUCCESS] Panen {komoditas.nama} sebanyak {jumlah_kg} kg berhasil dicatat.\")\n",
        "\n",
        "    def tampilkan_laporan(self):\n",
        "        print(f\"\\n==========================================\")\n",
        "        print(f\"   LAPORAN PANEN - {self.nama_kebun.upper()}\")\n",
        "        print(f\"==========================================\")\n",
        "\n",
        "        if not self.daftar_panen:\n",
        "            print(\"Belum ada data panen yang dicatat.\")\n",
        "            return\n",
        "\n",
        "        total_bobot = 0\n",
        "        total_pendapatan = 0\n",
        "\n",
        "        for p in self.daftar_panen:\n",
        "            nilai = p.hitung_total_nilai()\n",
        "            total_bobot += p.jumlah_kg\n",
        "            total_pendapatan += nilai\n",
        "            print(f\"ID #{p.id_panen} | Tgl: {p.tanggal} | {p.komoditas.nama:<10} | {p.jumlah_kg:>5} kg | Rp {nilai:>10,}\")\n",
        "\n",
        "        print(f\"------------------------------------------\")\n",
        "        print(f\"Total Hasil Panen : {total_bobot} kg\")\n",
        "        print(f\"Total Estimasi    : Rp {total_pendapatan:,}\")\n",
        "        print(f\"==========================================\\n\")\n",
        "\n",
        "\n",
        "# === Simulasi Penggunaan Sistem ===\n",
        "if __name__ == \"__main__\":\n",
        "    # 1. Inisialisasi Sistem Kebun\n",
        "    kebun_makmur = SistemAgroindustri(\"PT Agro Makmur Sejahtera\")\n",
        "\n",
        "    # 2. Definisikan Komoditas\n",
        "    sawit = Komoditas(\"Kelapa Sawit\", 2500)\n",
        "    kopi = Komoditas(\"Kopi Arabika\", 45000)\n",
        "    kakao = Komoditas(\"Kakao\", 30000)\n",
        "\n",
        "    # 3. Catat Transaksi Panen\n",
        "    kebun_makmur.catat_panen(sawit, 1200, \"2026-10-01\")\n",
        "    kebun_makmur.catat_panen(kopi, 150, \"2026-10-01\")\n",
        "    kebun_makmur.catat_panen(kakao, 300, \"2026-10-02\")\n",
        "\n",
        "    # 4. Cetak Laporan\n",
        "    kebun_makmur.tampilkan_laporan()"
